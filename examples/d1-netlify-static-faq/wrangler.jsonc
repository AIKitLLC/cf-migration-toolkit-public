{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "d1-netlify-static-faq",
  "compatibility_date": "2026-10-15",
  // Do not deploy this file from CI.
  // Pages are static assets. X-Robots-Tag: noindex is in site/dist/_headers.
  // /__cfmt-invoke is the only path sent to the User Worker, so the smoke
  // request produces an invocation log. Other paths stay on the asset worker.
  "main": "./src/invoke.js",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/__cfmt-invoke"]
  }
}
